# ── Cloudflare Turnstile (bot protection on the forms) ──────────────────────
# Public site key — rendered in the browser widget
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Private secret key — used server-side to verify tokens
NUXT_TURNSTILE_SECRET_KEY=

# ── SMTP for form leads ─────────────────────────────────────────────────────
# Mode A · IP-based relay (Microsoft 365 connector / direct send) — no credentials.
#   The server's static public IP must be authorised in the M365 connector.
#   Host = your domain's MX target (M365 admin → Domains → DNS), e.g.:
NUXT_SMTP_HOST=fl-rene-dk.mail.protection.outlook.com
NUXT_SMTP_PORT=25
# Leave USER/PASS empty for IP relay
NUXT_SMTP_USER=
NUXT_SMTP_PASS=

# Mode B · SMTP AUTH (username + app password) — uncomment to use instead:
# NUXT_SMTP_HOST=smtp.office365.com
# NUXT_SMTP_PORT=587
# NUXT_SMTP_USER=info@fl-rene.dk
# NUXT_SMTP_PASS=<app-password>

# Where leads are delivered, and the sender address (your own domain)
NUXT_LEAD_EMAIL_TO=info@fl-rene.dk
NUXT_LEAD_EMAIL_FROM=info@fl-rene.dk

# ── Notes ───────────────────────────────────────────────────────────────────
# - Without Turnstile keys, verification is skipped (dev).
# - Without NUXT_SMTP_HOST, leads are logged to the server console (dev).
# - If USER+PASS are set → SMTP AUTH; if empty → unauthenticated IP relay.
# - Cloudflare test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
